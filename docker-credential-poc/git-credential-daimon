#!/usr/bin/env python3
"""
git-credential-daimon - Client-side credential helper that talks to the socket server.

This is what git calls. It connects to the credential server socket,
sends the request, and outputs the response.

Install as: git config --global credential.helper '/usr/local/bin/git-credential-daimon'
"""

import socket
import sys
import os

SOCKET_PATH = "/run/git-credentials.sock"

def main():
    if len(sys.argv) < 2:
        print("Usage: git-credential-daimon <get|store|erase>", file=sys.stderr)
        sys.exit(1)

    operation = sys.argv[1]

    # Only handle "get" - git also calls store/erase but we don't need those
    if operation != "get":
        sys.exit(0)

    # Read input from git (host, protocol, etc.)
    input_lines = []
    for line in sys.stdin:
        line = line.strip()
        if not line:
            break
        input_lines.append(line)

    # Build request: operation + input
    request = operation + "\n" + "\n".join(input_lines) + "\n\n"

    # Connect to credential server
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(SOCKET_PATH)
        sock.sendall(request.encode())

        # Read response
        response = b""
        while True:
            chunk = sock.recv(4096)
            if not chunk:
                break
            response += chunk
        sock.close()

        # Output response (git credential protocol format)
        decoded = response.decode()
        if decoded.startswith("error:"):
            print(decoded, file=sys.stderr)
            sys.exit(1)

        # Output to stdout for git
        print(decoded, end="")

    except FileNotFoundError:
        print("error: credential server not running (socket not found)", file=sys.stderr)
        sys.exit(1)
    except ConnectionRefusedError:
        print("error: credential server refused connection", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
